# ==============================================================================
# 🚀 FLOWCREATOR OS (REELSTUDIO PRO) — MASTER ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GROQ CLOUD AI (Speech-to-Text Transcription)
# ------------------------------------------------------------------------------
# Kahan se milegi: https://console.groq.com/keys
# Cost: 100% Free (Zero credit card required)
# Kis liye chahiye: Whisper Large v3 Turbo model ke zariye 1-second ultra-fast
#                   word-level timestamps aur viral captions generate karne ke liye.
# Kahan lagani hai: Hugging Face Space -> Settings -> "Variables and secrets" ya local .env
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. NEON SERVERLESS POSTGRESQL DATABASE (1000+ Music Search & Catalog)
# ------------------------------------------------------------------------------
# Kahan se milegi: https://neon.tech
# Cost: 100% Free (Zero credit card required, instant setup)
# Kis liye chahiye: 1000+ gaano ka metadata (Title, Category, Tags, Play Count, Mood)
#                   store aur 0.005s mein full-text search query karne ke liye.
# Setup: Neon console se Connection String (Pooled ya Direct) copy karein.
#        Run backend/schema.sql to create tables and indexes.
# Kahan lagani hai: Hugging Face Space -> Settings -> "Variables and secrets" ya local .env
DATABASE_URL=postgresql://neondb_owner:your_password@ep-unique-id.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 OBJECT STORAGE (1000+ Heavy Audio Files Storage & CDN)
# ------------------------------------------------------------------------------
# Kahan se milegi: https://dash.cloudflare.com -> R2 Object Storage
# Cost: 100% Free (10 GB storage free, Zero bandwidth/egress cost)
# Kis liye chahiye: Heavy audio files (.mp3 / .wav) ko store karne ke liye
#                   taake browser instant stream kare aur FFmpeg video mein mix kare.
# Setup: 1. Cloudflare Dashboard -> R2 -> "Create Bucket" (e.g. flowcreator-music)
#        2. Bucket Settings -> "Public Development Access" Enable karein.
# Kahan lagani hai: Public URL ko backend aur database me audio link ke tor pe use karein.
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# (Optional: Agar Python auto-uploader script ke zariye bulk 1000 songs upload karne hon)
# Cloudflare -> R2 -> "Manage R2 API Tokens" -> "Create API Token"
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=flowcreator-music

# ------------------------------------------------------------------------------
# 4. FRONTEND NEXT.JS API URL (Vercel)
# ------------------------------------------------------------------------------
# Kahan se milegi: Aapke Hugging Face Space ka direct domain:
#                  https://01talha-arqa-chatbot.hf.space
# Kis liye chahiye: Next.js frontend ko backend FastAPI server se connect karne ke liye.
# Kahan lagani hai: Vercel Project -> Settings -> Environment Variables
NEXT_PUBLIC_API_URL=https://01talha-arqa-chatbot.hf.space
# Local development ke liye:
# NEXT_PUBLIC_API_URL=http://localhost:7860

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME PORT
# ------------------------------------------------------------------------------
PORT=7860

# ------------------------------------------------------------------------------
# 6. HUGGING FACE TOKEN (GitHub Actions Auto-Deployment)
# ------------------------------------------------------------------------------
# Kahan se milegi: https://huggingface.co/settings/tokens
# Permission: "Write" role
# Kis liye chahiye: Jab aap GitHub par code push karein to GitHub Action automatically
#                   Hugging Face Space ko deploy/update kar de.
# Kahan lagani hai: GitHub Repo -> Settings -> Secrets and variables -> Actions -> "HF_TOKEN"
# HF_TOKEN=hf_your_write_token_here
