# FlowCreator OS - Environment Variables Configuration

# 1. Backend AI Settings (FastAPI / Groq)
# Get your free fast API key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Backend Port (Default: 7860 for Hugging Face Spaces compatibility)
PORT=7860

# 2. Frontend Settings (Next.js)
# In production on Vercel, set this to: https://01talha-arqa-chatbot.hf.space
NEXT_PUBLIC_API_URL=http://localhost:7860
