# ==============================================================================
# FASTAPI BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Groq Cloud Speech API Key (https://console.groq.com/keys) - Free
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Neon Serverless Postgres (https://neon.tech) - Free (For 1000+ Music Search)
# Run backend/schema.sql to set up tables
DATABASE_URL=postgresql://neondb_owner:your_password@ep-unique-id.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. Cloudflare R2 Public CDN Base URL (https://dash.cloudflare.com -> R2)
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# 4. Optional Cloudflare R2 API Credentials (For automatic Python bulk uploading)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=flowcreator-music

# 5. Server Port (Default: 7860 for Hugging Face Spaces Docker)
PORT=7860
